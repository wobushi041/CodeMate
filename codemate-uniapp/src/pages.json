{
  "pages": [
    { "path": "pages/auth/login", "style": { "navigationStyle": "custom" } },
    { "path": "pages/auth/register", "style": { "navigationStyle": "custom" } },
    { "path": "pages/index/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/match/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/team/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/ai/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/user/index", "style": { "navigationStyle": "custom" } }
  ],
  "tabBar": {
    "color": "#cac6c0",
    "selectedColor": "#ffffff",
    "backgroundColor": "#292724",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/index/index", "text": "主页" },
      { "pagePath": "pages/match/index", "text": "匹配" },
      { "pagePath": "pages/team/index", "text": "队伍" },
      { "pagePath": "pages/ai/index", "text": "AI助手" },
      { "pagePath": "pages/user/index", "text": "我的" }
    ]
  },
  "globalStyle": {
    "navigationBarBackgroundColor": "#faf9f6",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#faf9f6",
    "backgroundTextStyle": "dark"
  },
  "subPackages": [
    { "root": "subpages/search", "pages": [{ "path": "index", "style": { "navigationBarTitleText": "标签搜索" } }, { "path": "result", "style": { "navigationBarTitleText": "搜索结果" } }] },
    { "root": "subpages/user", "pages": [{ "path": "edit", "style": { "navigationBarTitleText": "编辑资料" } }, { "path": "created", "style": { "navigationBarTitleText": "我创建的队伍" } }, { "path": "joined", "style": { "navigationBarTitleText": "我加入的队伍" } }] },
    { "root": "subpages/team", "pages": [{ "path": "add", "style": { "navigationBarTitleText": "创建队伍" } }, { "path": "update", "style": { "navigationBarTitleText": "更新队伍" } }] },
    { "root": "subpages/chat", "pages": [{ "path": "private", "style": { "navigationBarTitleText": "私聊" } }, { "path": "team", "style": { "navigationBarTitleText": "队伍聊天" } }] }
  ],
  "easycom": {
    "autoscan": true,
    "custom": { "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue" }
  }
